<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        使用 Bridge 主题，保证自定义 TextView 背景在 Material 组件环境下生效。
        界面自行绘制灰色标题栏，因此使用 NoActionBar。
    -->
    <style name="Base.Theme.Ex6" parent="Theme.MaterialComponents.Light.NoActionBar.Bridge">
        <item name="colorPrimary">@color/brand_dark</item>
        <item name="colorPrimaryVariant">#A65353</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="Theme.Ex6" parent="Base.Theme.Ex6" />
</resources>
